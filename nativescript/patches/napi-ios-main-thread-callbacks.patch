 // Bridge calls from Objective-C to JavaScript.
 // Opposite of what native_call.cc does - but a lot of type conversion logic
 // is reused, just in reverse.
+// Embedder configuration: see detail::main_thread_callbacks_inline.
+extern "C" NAPI_EXPORT void nativescript_set_main_thread_callbacks(bool runInline,
+                                                                  void (*enter)(void),
