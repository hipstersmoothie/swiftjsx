+// Weak references.
+//
+// JSC's public C API has no weak handles. Liveness used to be tracked with a
+// finalizer on the target: until it ran, the target counted as alive. But JSC
+// runs finalizers lazily, when it *sweeps*, which can be well after the
+// collection that found the object dead. In that window a weak ref returned a
+// dead cell (and ref() would protect it, resurrecting it). Under allocation
+// churn, callers such as NativeScript's pointer cache then crashed reading it.
+//
+// Object targets are now tracked with a JS `WeakRef`, which the collector
+// clears *during* collection: deref() is undefined exactly when the target is
+// dead. As with any WeakRef, a target observed during the current synchronous
+// job is kept alive until that job ends.
+namespace {
+JSObjectRef WeakRefNew(napi_env env, JSValueRef target) {
+  if (env->weak_ref_constructor == nullptr) {
+    JSObjectRef global = JSContextGetGlobalObject(env->context);
+    JSValueRef ctor = JSObjectGetProperty(env->context, global, JSString("WeakRef"), nullptr);
+    if (ctor == nullptr || !JSValueIsObject(env->context, ctor)) return nullptr;
+    JSValueRef proto = JSObjectGetProperty(env->context, (JSObjectRef)ctor, JSString("prototype"), nullptr);
+    if (proto == nullptr || !JSValueIsObject(env->context, proto)) return nullptr;
+    JSValueRef deref = JSObjectGetProperty(env->context, (JSObjectRef)proto, JSString("deref"), nullptr);
+    if (deref == nullptr || !JSValueIsObject(env->context, deref)) return nullptr;
+    env->weak_ref_constructor = (JSObjectRef)ctor;
+    env->weak_ref_deref = (JSObjectRef)deref;
+    JSValueProtect(env->context, ctor);
+    JSValueProtect(env->context, deref);
+  }
+
+  JSValueRef exception{};
+  JSObjectRef weak = JSObjectCallAsConstructor(env->context, env->weak_ref_constructor, 1, &target, &exception);
+  if (exception != nullptr || weak == nullptr) return nullptr;
+  JSValueProtect(env->context, weak);
+  return weak;
+}
+
+// Whether the WeakRef's target is still alive.
+bool WeakRefIsAlive(napi_env env, JSObjectRef weak) {
+  JSValueRef exception{};
+  JSValueRef value = JSObjectCallAsFunction(env->context, env->weak_ref_deref, weak, 0, nullptr, &exception);
+  return exception == nullptr && value != nullptr && !JSValueIsUndefined(env->context, value);
+}
