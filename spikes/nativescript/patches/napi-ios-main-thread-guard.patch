diff --git a/NativeScript/ffi/napi/MainThreadGuard.h b/NativeScript/ffi/napi/MainThreadGuard.h
new file mode 100644
index 0000000..c4a6137
--- /dev/null
+++ b/NativeScript/ffi/napi/MainThreadGuard.h
@@ -0,0 +1,85 @@
+#ifndef NATIVESCRIPT_MAIN_THREAD_GUARD_H
+#define NATIVESCRIPT_MAIN_THREAD_GUARD_H
+
+#include <objc/runtime.h>
+#include <pthread.h>
+
+#include <atomic>
+#include <cstdint>
+
+#include "js_native_api.h"
+
+// Main-thread guard: when the embedder opts in with
+// nativescript_set_main_thread_guard(true), a JS call into a @MainActor
+// Objective-C member from a thread other than the main thread throws a JS
+// Error instead of running.
+//
+// Isolation comes from the metadata (the SDK's NS_SWIFT_UI_ACTOR /
+// NS_SWIFT_NONISOLATED annotations, see MDStringOffsetFlag) and is resolved
+// once, when a member is bound to its JS class (ObjCClassMember::defineMembers):
+//   1. the member is nonisolated                  -> not guarded
+//   2. the member itself is @MainActor            -> guarded
+//   3. it comes from a @MainActor protocol        -> guarded
+//   4. its declaring class, or any superclass of
+//      it, is @MainActor                          -> guarded
+//   5. it's alloc/allocWithZone:/new/init*, which
+//      NSObject declares for every class          -> guarded if the receiver's
+//                                                    class is @MainActor
+//                                                    (checked at call time)
+// Only JS -> native calls are checked. Native code calling JS-implemented
+// methods (the callback path) is never affected.
+
+namespace nativescript {
+
+class ObjCBridgeState;
+class ObjCClassMember;
+
+enum MainThreadGuardKind : uint8_t {
+  kMainThreadGuardNone = 0,
+  // Guarded regardless of receiver (rules 2-4).
+  kMainThreadGuardAlways = 1,
+  // Guarded if the receiver's class is @MainActor (rule 5).
+  kMainThreadGuardReceiver = 2,
+};
+
+enum MainThreadGuardAccess : uint8_t {
+  kMainThreadGuardCall,
+  kMainThreadGuardGet,
+  kMainThreadGuardSet,
+  kMainThreadGuardConstruct,
+};
+
+namespace detail {
+inline std::atomic<bool> main_thread_guard_enabled{false};
+}  // namespace detail
+
+inline bool isMainThreadGuardEnabled() {
+  return detail::main_thread_guard_enabled.load(std::memory_order_relaxed);
+}
+
+// Hot path: one byte test for unguarded members; a flag load and
+// pthread_main_np() for guarded ones.
+inline bool mainThreadGuardShouldCheck(uint8_t kind) {
+  return kind != kMainThreadGuardNone && isMainThreadGuardEnabled() &&
+         pthread_main_np() == 0;
+}
+
+// Name of the nearest class in cls's superclass chain (cls included) that is
+// annotated @MainActor, or nullptr if none is. JS subclasses resolve through
+// their native superclass.
+const char* mainActorSourceForClass(ObjCBridgeState* state, Class cls);
+
+// Slow path, off the main thread with the guard enabled. Throws and returns
+// true if `method` may not be called on `self` here.
+bool mainThreadGuardRejects(napi_env env, ObjCClassMember* method, id self,
+                            MainThreadGuardAccess access);
+
+// Slow path for `new Cls()` (access kMainThreadGuardConstruct) and
+// `Cls.alloc()` (kMainThreadGuardCall, member "alloc"). Throws and returns
+// true if Cls is @MainActor.
+bool mainThreadGuardRejectsClass(napi_env env, ObjCBridgeState* state, Class cls,
+                                 MainThreadGuardAccess access, const char* member);
+
+}  // namespace nativescript
+
+#endif  // NATIVESCRIPT_MAIN_THREAD_GUARD_H
