+bool mainThreadGuardRejects(napi_env env, ObjCClassMember* method, id self,
+                            MainThreadGuardAccess access) {
+  const bool receiverIsClass = object_isClass(self);
+  Class receiverClass = receiverIsClass ? (Class)self : object_getClass(self);
+  const char* receiverName = class_getName(receiverClass);
+
+  std::string reason;
+  if (method->mainThreadGuard == kMainThreadGuardReceiver) {
+    const char* source = mainActorSourceForClass(method->bridgeState, receiverClass);
+    if (source == nullptr) {
+      return false;
+    }
+    reason = receiverIsolationReason(receiverName, source);
+  } else if (method->mainActorSource != nullptr) {
+    reason = std::string(method->mainActorSource) + " is @MainActor";
+  } else {
+    reason = std::string(method->jsName != nullptr ? method->jsName : "it") + " is @MainActor";
+  }
+
+  // Static members and alloc/new/init read best with the receiver class the
+  // script named (UILabel.new()); instance members with their declaring class.
+  const char* owner = receiverName;
+  if (!receiverIsClass && method->mainThreadGuard != kMainThreadGuardReceiver &&
+      method->declaringName != nullptr) {
+    owner = method->declaringName;
+  }
+  std::string expression = std::string(owner) + "." + (method->jsName ? method->jsName : "?");
+  if (access == kMainThreadGuardCall) {
+    expression += "()";
+  } else if (access == kMainThreadGuardSet) {
+    expression += " = ...";
+  }
+  return throwMainThreadGuardError(env, expression, access, reason);
+}
