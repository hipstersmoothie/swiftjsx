+bool throwMainThreadGuardError(napi_env env, const std::string& expression,
+                               MainThreadGuardAccess access, const std::string& reason) {
+  const bool isAccess = access == kMainThreadGuardGet || access == kMainThreadGuardSet;
+  std::string message = expression + (isAccess ? " must be accessed" : " must be called") +
+                        " on the main thread (" + reason +
+                        "). Wrap it in onMain(() => ...).";
+  napi_throw_error(env, "ERR_NATIVESCRIPT_MAIN_THREAD", message.c_str());
+  return true;
+}
+
+std::string receiverIsolationReason(const char* receiverName, const char* source) {
+  if (strcmp(receiverName, source) == 0) {
+    return std::string(receiverName) + " is @MainActor";
+  }
+  return std::string(receiverName) + " inherits @MainActor from " + source;
+}
