+const char* mainActorSourceForClass(ObjCBridgeState* state, Class cls) {
+  if (state == nullptr) {
+    return nullptr;
+  }
+  for (Class current = cls; current != nil; current = class_getSuperclass(current)) {
+    auto bridged = state->classesByPointer.find(current);
+    if (bridged != state->classesByPointer.end() && bridged->second != nullptr) {
+      if (bridged->second->mainActorSource != nullptr) {
+        return bridged->second->mainActorSource;
+      }
+      if (bridged->second->metadataOffset != MD_SECTION_OFFSET_NULL) {
+        return nullptr;  // resolved over its whole superclass chain
+      }
+    }
+    auto metadataClass = state->mdClassesByPointer.find(current);
+    if (metadataClass != state->mdClassesByPointer.end()) {
+      MDSectionOffset nameOffset = state->metadata->getOffset(metadataClass->second);
+      if (MDMetadataReader::isMainActorOffset(nameOffset)) {
+        return state->metadata->resolveString(nameOffset);
+      }
+    }
+  }
+  return nullptr;
