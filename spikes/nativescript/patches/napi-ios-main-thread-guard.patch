+// Swift concurrency annotations on a declaration, from the attributes Swift
+// itself imports: NS_SWIFT_UI_ACTOR / NS_SWIFT_MAIN_ACTOR expand to
+// __attribute__((swift_attr("@MainActor"))), NS_SWIFT_NONISOLATED to
+// swift_attr("nonisolated"), NS_SWIFT_SENDABLE to swift_attr("@Sendable").
+struct SwiftIsolationAttrs {
+  bool mainActor = false;
+  bool nonisolated = false;
+  bool sendable = false;
+};
+
+// libclang exposes swift_attr only as a CXCursor_UnexposedAttr child with no
+// spelling, no tokens and no pretty-printed form. Its extent, however, covers
+// the attribute as written in the header: either the macro invocation
+// ("NS_SWIFT_UI_ACTOR", "CARPLAY_TEMPLATE_UI_ACTOR", "CF_SWIFT_NONISOLATED")
+// or a literal __attribute__((swift_attr("..."))). Classify that text.
+inline void classifySwiftAttrText(const std::string& text,
+                                  SwiftIsolationAttrs& attrs) {
+  auto contains = [&](const char* needle) {
+    return text.find(needle) != std::string::npos;
+  };
+
+  if (contains("swift_attr")) {
+    if (contains("\"@MainActor\"") || contains("\"@UIActor\"")) {
+      attrs.mainActor = true;
+    }
+    if (contains("\"nonisolated")) {
+      attrs.nonisolated = true;
+    }
+    if (contains("\"@Sendable\"")) {
+      attrs.sendable = true;
+    }
+    return;
+  }
+
+  // A single macro name, e.g. NS_SWIFT_UI_ACTOR. Every SDK wrapper of the
+  // actor macros keeps MAIN_ACTOR / UI_ACTOR / NONISOLATED in its name.
+  if (text.empty() ||
+      !(std::isalpha((unsigned char)text[0]) || text[0] == '_')) {
+    return;
+  }
+  for (char c : text) {
+    if (!(std::isalnum((unsigned char)c) || c == '_')) {
+      return;
+    }
+  }
+  if (contains("MAIN_ACTOR") || contains("UI_ACTOR")) {
+    attrs.mainActor = true;
+  } else if (contains("NONISOLATED")) {
+    attrs.nonisolated = true;
+  } else if (contains("_SENDABLE") && !contains("NONSENDABLE") &&
+             !contains("SUPPRESS_SENDABLE")) {
+    attrs.sendable = true;
+  }
+}
+
+inline SwiftIsolationAttrs getSwiftIsolationAttrs(CXCursor cursor) {
+  SwiftIsolationAttrs attrs;
+  clang_visitChildren(
+      cursor,
+      [](CXCursor child, CXCursor, CXClientData clientData) {
+        if (child.kind != CXCursor_UnexposedAttr) {
+          return CXChildVisit_Continue;
+        }
+        auto* attrs = static_cast<SwiftIsolationAttrs*>(clientData);
+
+        CXSourceRange range = clang_getCursorExtent(child);
+        CXFile startFile = nullptr, endFile = nullptr;
+        unsigned start = 0, end = 0;
+        clang_getSpellingLocation(clang_getRangeStart(range), &startFile,
+                                  nullptr, nullptr, &start);
+        clang_getSpellingLocation(clang_getRangeEnd(range), &endFile, nullptr,
+                                  nullptr, &end);
+        if (startFile == nullptr || endFile == nullptr ||
+            !clang_File_isEqual(startFile, endFile) || end <= start ||
+            end - start > 512) {
+          return CXChildVisit_Continue;
+        }
+
+        size_t size = 0;
+        const char* contents = clang_getFileContents(
+            clang_Cursor_getTranslationUnit(child), startFile, &size);
+        if (contents == nullptr || end > size) {
+          return CXChildVisit_Continue;
+        }
+
+        classifySwiftAttrText(std::string(contents + start, end - start),
+                              *attrs);
+        return CXChildVisit_Continue;
+      },
+      &attrs);
+  return attrs;
+}
