+  // Metadata offset for a (possibly tagged) class / protocol pointer, or
+  // MD_SECTION_OFFSET_NULL. Replaces linear scans over mdClassesByPointer /
+  // mdProtocolsByPointer comparing normalized keys.
+  inline MDSectionOffset classMetadataOffsetForPointer(const void* pointer) const {
+    auto it = mdClassesByNormalizedPointer.find(NormalizeHandleKey((void*)pointer));
+    return it != mdClassesByNormalizedPointer.end() ? it->second : MD_SECTION_OFFSET_NULL;
+  }
+
+  inline MDSectionOffset protocolMetadataOffsetForPointer(const void* pointer) const {
+    auto it = mdProtocolsByNormalizedPointer.find(NormalizeHandleKey((void*)pointer));
+    return it != mdProtocolsByNormalizedPointer.end() ? it->second : MD_SECTION_OFFSET_NULL;
+  }
+
+  // The runtime Protocol at this (possibly tagged) address, or nil.
+  // objc_copyProtocolList() copies every protocol in the process (thousands),
+  // so its result is indexed once and rebuilt only after new images load.
+  // Protocols registered at runtime by objc_registerProtocol() have no
+  // metadata, so callers had no use for them anyway.
+  inline Protocol* runtimeProtocolForPointer(const void* pointer) {
+    const uint32_t imageCount = _dyld_image_count();
+    if (imageCount != runtimeProtocolsImageCount) {
+      runtimeProtocolsByNormalizedPointer.clear();
+      unsigned int count = 0;
+      Protocol* __unsafe_unretained* protocols = objc_copyProtocolList(&count);
+      if (protocols != nullptr) {
+        for (unsigned int i = 0; i < count; i++) {
+          runtimeProtocolsByNormalizedPointer[NormalizeHandleKey((void*)protocols[i])] = protocols[i];
+        }
+        ::free(protocols);
+      }
+      runtimeProtocolsImageCount = imageCount;
+    }
+
+    auto it = runtimeProtocolsByNormalizedPointer.find(NormalizeHandleKey((void*)pointer));
+    return it != runtimeProtocolsByNormalizedPointer.end() ? it->second : nil;
+  }
