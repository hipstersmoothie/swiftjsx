{
  "name": "swiftjsx",
  "version": "0.1.0",
  "description": "React and JSX, rendered as SwiftUI: write iOS and macOS apps with React.",
  "license": "MIT",
  "author": "Andrew Lisowski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hipstersmoothie/swiftjsx.git"
  },
  "type": "module",
  "bin": {
    "swiftjsx": "cli/swiftjsx.mjs"
  },
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "cli",
    "dist/types",
    "template",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "build:types": "node scripts/build-types.mjs",
    "prepack": "node scripts/build-types.mjs"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-reconciler": "^0.34.0",
    "react-refresh": "^0.19.0"
  },
  "devDependencies": {
    "@babel/generator": "^7.29.8",
    "@tanstack/react-query": "^5.105.0",
    "@types/babel__core": "^7.20.5",
    "@types/react": "^19.3.0",
    "@types/react-reconciler": "^0.34.1",
    "axios": "^1.21.0",
    "date-fns": "^4.4.0",
    "immer": "^11.2.9",
    "jotai": "^3.0.1",
    "nanoid": "^6.0.2",
    "react-devtools-core": "^8.0.0",
    "swr": "^2.5.1",
    "typescript": "^7.0.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  }
}
